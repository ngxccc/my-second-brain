// GreenRoots Farm Database Schema (DBML)
// Docs: https://dbml.org/docs/
// Generated: 2026-11-12
// Author: Tran Van Ngoc (Leader / Backend Architect)

Project GreenRootsFarm {
  database_type: 'PostgreSQL'
  Note: 'Production-ready database schema for GreenRoots Farm - Single Farm D2C E-commerce & Operations Management System in NestJS & Drizzle ORM'
}

// ==========================================
// ENUM DECLARATIONS (DOMAIN TYPES)
// ==========================================

enum user_role {
  guest
  customer
  farm_staff
  sales
  admin
  super_admin
}

enum user_status {
  active
  inactive
  suspended
}

enum season_status {
  planning
  active
  harvested
  completed
}

enum farming_action_type {
  seeding
  watering
  bio_fertilizing
  weeding
  pest_control
  soil_testing
  harvesting
  correction
}

enum batch_status {
  in_stock
  near_expiry
  sold_out
  expired
}

enum order_status {
  pending_payment
  pending_confirmation
  packing
  shipping
  delivered
  completed
  cancelled
}

enum payment_method {
  cod
  payos
  subscription
}

enum payment_status {
  pending
  paid
  failed
  refunded
}

enum payment_transaction_type {
  payment
  refund
}

enum delivery_day {
  tuesday
  friday
  both
}

enum subscription_status {
  active
  paused
  completed
  cancelled
}

enum complaint_status {
  pending
  approved
  rejected
}

enum complaint_resolution {
  refund
  replacement
}

enum waste_log_status {
  pending_approval
  approved
  rejected
}

// ==========================================
// 1. USERS & ACCESS CONTROL (RBAC)
// ==========================================

Table users {
  id uuid [pk, note: 'Time-sortable UUIDv7 primary key']
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  deleted_at timestamp [note: 'Soft delete timestamp (NULL when active); email unique index scoped WHERE deleted_at IS NULL']
  email varchar(255) [not null, unique]
  phone varchar(20) [note: 'Optional profile or internal staff contact phone; delivery recipient phone lives in user_addresses.phone_number']
  password varchar(255) [not null, note: 'Hashed password string via scrypt (node:crypto) with versioned format s1$<salt>$<hash>']
  full_name varchar(255) [not null]
  role user_role [not null, default: 'customer']
  reward_points integer [not null, default: 0, note: 'Accumulated loyalty reward points (1% per order)']
  status user_status [not null, default: 'active', note: 'Operational account status, orthogonal to email_verified']
  email_verified boolean [not null, default: false, note: 'Email authentication verification flag']
  verification_token varchar(255) [note: 'Email verification token']
  verification_expires_at timestamp [note: 'Expiration timestamp for email verification']
  reset_password_token varchar(255) [note: 'Password reset token']
  reset_password_expires_at timestamp [note: 'Expiration timestamp for password reset']

  Note: 'Unified User entity supporting 6 system roles with RBAC guards and email authentication lifecycle'

  Indexes {
    email [unique, name: "users_email_uidx", note: 'Partial unique index: WHERE deleted_at IS NULL']
    phone [name: "users_phone_idx"]
    role [name: "users_role_idx"]
    status [name: "users_status_idx"]
    verification_token [name: "users_verification_token_idx"]
    reset_password_token [name: "users_reset_password_token_idx"]
  }
}

Table refresh_tokens {
  id uuid [pk, note: 'UUIDv7 primary key']
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  user_id uuid [not null, note: 'Cascade deleted when user is deleted']
  token varchar(255) [not null, unique, note: 'Hashed refresh token string for atomic single-use rotation']
  device_name varchar(255) [note: 'Client user-agent or device descriptor']
  ip_address varchar(45) [note: 'Client IP address']
  expires_at timestamp [not null, note: 'Refresh token expiry timestamp (e.g. 7 days)']

  Note: 'Durable session management in PostgreSQL guaranteeing ACID logout and token rotation without Redis volatility'

  Indexes {
    token [unique, name: "refresh_tokens_token_uidx"]
    user_id [name: "refresh_tokens_user_id_idx"]
    expires_at [name: "refresh_tokens_expires_at_idx"]
  }
}

Table user_addresses {
  id uuid [pk, note: 'UUIDv7 primary key']
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  user_id uuid [not null, note: 'Belongs to customer, cascade deleted with user']
  receiver_name varchar(255) [not null]
  phone_number varchar(20) [not null]
  street_address text [not null]
  district varchar(100) [not null]
  city varchar(100) [not null, default: 'TP. Hồ Chí Minh']
  latitude decimal(10,8) [note: 'Customer coordinate for Haversine distance shipping calculation']
  longitude decimal(11,8) [note: 'Customer coordinate for Haversine distance shipping calculation']
  is_default boolean [not null, default: false]

  Note: 'Customer delivery address book enabling quick checkout and recurring subscription routing'

  Indexes {
    user_id [name: "user_addresses_user_id_idx"]
    (user_id, is_default) [name: "user_addresses_default_idx"]
  }
}

// ==========================================
// 2. FARM OPERATIONS & TRACEABILITY
// ==========================================

Table farms {
  id uuid [pk, note: 'UUIDv7 primary key']
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  name varchar(255) [not null, default: 'GreenRoots Farm']
  legal_name varchar(255) [not null, default: 'Công ty TNHH Nông nghiệp Hữu cơ GreenRoots']
  tagline varchar(255) [note: 'Storefront hero/brand slogan']
  tax_id varchar(50)
  address text [not null]
  latitude decimal(10,8) [not null, note: 'Fixed farm latitude coordinate for Haversine distance shipping calculation']
  longitude decimal(11,8) [not null, note: 'Fixed farm longitude coordinate for Haversine distance shipping calculation']
  certification_url text [note: 'Official URL to national VietGAP / USDA certified portal']
  hotlines jsonb [not null, note: 'JSON Schema: object { primary: string, support?: string }']
  emails jsonb [not null, note: 'JSON Schema: object { primary: string, support?: string }']
  working_hours jsonb [not null, note: 'JSON Schema: object { weekdays: string, weekend: string }']
  bank_info jsonb [note: 'JSON Schema: object { bankName: string, accountNumber: string, accountHolder: string } (Public display only; API secrets live strictly in .env)']
  shipping_config jsonb [not null, note: 'JSON Schema: object { baseFeeVnd: number, freeKmThreshold: number, perKmRateVnd: number, detourFactor: number }']
  flash_sale_config jsonb [not null, note: 'JSON Schema: object { hoursThreshold: number, discountPercent: number }']
  is_payos_enabled boolean [not null, default: true, note: 'Runtime toggle for PayOS checkout; PayOS API keys stay in .env']
  is_cod_enabled boolean [not null, default: true, note: 'Runtime toggle for Cash on Delivery']

  Note: 'Single Farm core entity & dynamic singleton settings (public/operational only; secrets stay in .env)'
}

Table plots {
  id uuid [pk, note: 'UUIDv7 primary key']
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  deleted_at timestamp [note: 'Soft delete timestamp (NULL when active); plot_code unique index scoped WHERE deleted_at IS NULL']
  farm_id uuid [not null, note: 'Belongs to farm']
  plot_code varchar(50) [not null, unique, note: 'E.g. PLOT-A1, PLOT-B2']
  name varchar(255) [not null]
  area_sqm decimal(10,2) [not null, note: 'Plot area in square meters']
  soil_test_result jsonb [note: 'JSON Schema: object { ph: number, nitrogen_ppm: number, phosphorus_ppm: number, potassium_ppm: number, heavy_metals: { lead_ppm: number, cadmium_ppm: number, pass: boolean }, tested_at: string, certificate_url?: string }']
  water_test_result jsonb [note: 'JSON Schema: object { ph: number, ec_ms_cm: number, dissolved_oxygen_ppm: number, e_coli_cfu_100ml: number, heavy_metals_pass: boolean, tested_at: string, certificate_url?: string }']

  Note: 'Physical land cultivation plots within the farm'

  Indexes {
    farm_id [name: "plots_farm_id_idx"]
    plot_code [unique, name: "plots_plot_code_uidx", note: 'Partial unique index: WHERE deleted_at IS NULL']
  }
}

Table seasons {
  id uuid [pk, note: 'UUIDv7 primary key']
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  plot_id uuid [not null, note: 'Plot dedicated for this seasonal crop']
  season_name varchar(255) [not null, note: 'E.g. Vu Dong Xuan 2026 - Ca Chua Bi']
  start_date date [not null]
  expected_harvest_date date [not null]
  status season_status [not null, default: 'planning']

  Note: 'Cultivation seasons tracking crop lifecycle from planting to harvest'

  Indexes {
    plot_id [name: "seasons_plot_id_idx"]
    status [name: "seasons_status_idx"]
  }
}

Table farming_logs {
  id uuid [pk, note: 'UUIDv7 primary key']
  season_id uuid [not null, note: 'Season being documented']
  staff_id uuid [not null, note: 'Farm staff engineer recording this entry']
  action_type farming_action_type [not null]
  description text [not null, note: 'Detailed field activity notes']
  media_urls jsonb [note: 'JSON Schema: string[] (Array of 1-3 Cloudinary URLs: photos <=300KB or video <=15s/15MB)']
  logged_at timestamp [not null, default: `now()`, note: 'Append-only immutable event timestamp']

  Note: 'Immutable append-only cultivation log. Modifying or deleting is strictly prohibited for traceability integrity'

  Indexes {
    (season_id, logged_at) [name: "farming_logs_season_id_logged_at_idx"]
    staff_id [name: "farming_logs_staff_id_idx"]
  }
}

// ==========================================
// 3. PRODUCT CATALOG & BATCH INVENTORY (FEFO)
// ==========================================

Table categories {
  id uuid [pk, note: 'UUIDv7 primary key']
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  deleted_at timestamp [note: 'Soft delete timestamp (NULL when active); name/slug unique indexes scoped WHERE deleted_at IS NULL']
  name varchar(255) [not null, unique, note: 'E.g. Rau an la, Rau cu qua, Rau gia vi']
  slug varchar(255) [not null, unique]
  description text
  parent_id uuid [note: 'Self-referencing nullable FK for multi-level category hierarchy (e.g. Rau cu qua -> Cu qua)']
  sort_order integer [not null, default: 0, note: 'Display sorting order on Storefront sidebar navigation']
  is_active boolean [not null, default: true, note: 'Active category visibility toggle']

  Note: 'Product category taxonomy with hierarchical navigation and sorting support'

  Indexes {
    slug [unique, name: "categories_slug_uidx", note: 'Partial unique index: WHERE deleted_at IS NULL']
    parent_id [name: "categories_parent_id_idx"]
    is_active [name: "categories_is_active_idx"]
  }
}

Table products {
  id uuid [pk, note: 'UUIDv7 primary key']
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  deleted_at timestamp [note: 'Soft delete timestamp (NULL when active); slug unique index scoped WHERE deleted_at IS NULL']
  category_id uuid [not null, note: 'Belongs to category']
  name varchar(255) [not null, note: 'E.g. Ca chua bi huu co']
  slug varchar(255) [not null, unique]
  description text
  base_price integer [not null, note: 'Price in VND per standard sales unit']
  unit varchar(50) [not null, default: 'kg', note: 'Standard unit: kg, bo, goi 500g']
  image_urls jsonb [note: 'JSON Schema: string[] (Array of 1 to 5 Cloudinary product showcase image URLs, e.g. ["https://.../img1.webp"])']
  is_subscription_eligible boolean [not null, default: true, note: 'Can be included in recurring family subscription baskets']
  is_active boolean [not null, default: true]

  Note: 'Commercial agricultural products displayed on Customer Storefront'

  Indexes {
    slug [unique, name: "products_slug_uidx", note: 'Partial unique index: WHERE deleted_at IS NULL']
    category_id [name: "products_category_id_idx"]
  }
}

Table batches {
  id uuid [pk, note: 'UUIDv7 primary key']
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  batch_code varchar(100) [not null, unique, note: 'E.g. BATCH-2026-TOM-01']
  season_id uuid [not null, note: 'Harvested from specific crop season']
  product_id uuid [not null, note: 'Refers to catalog product']
  harvest_date date [not null]
  expiration_date date [not null, note: 'Crucial for FEFO (First-Expired, First-Out) outbound algorithm']
  initial_quantity decimal(10,2) [not null, note: 'Total harvest weight in kg']
  available_quantity decimal(10,2) [not null, note: 'Remaining in-stock weight ready for sale. Decremented upon order confirmation']
  qr_code_url text [note: 'Pre-generated QR code image URL linking to public trace page']
  status batch_status [not null, default: 'in_stock']

  Note: 'Core inventory batch entity. Directly controls FEFO allocation, expiry alerts, and QR traceability'

  Indexes {
    batch_code [unique, name: "batches_batch_code_uidx"]
    product_id [name: "batches_product_id_idx"]
    (expiration_date, status) [name: "batches_fefo_outbound_idx", note: 'Optimizes FEFO SELECT ... FOR UPDATE sorting by expiration_date ASC']
  }
}

Table waste_logs {
  id uuid [pk, note: 'UUIDv7 primary key']
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  batch_id uuid [not null, note: 'Batch being written off']
  reported_by uuid [not null, note: 'Farm staff or Sales filing write-off proposal']
  approved_by uuid [note: 'Admin approving final physical stock deduction']
  discarded_quantity decimal(10,2) [not null, note: 'Weight of damaged/spoiled produce in kg']
  reason varchar(255) [not null, note: 'E.g. Dap nat sau thu hoach, Heo ua qua han 48h']
  media_urls jsonb [not null, note: 'JSON Schema: string[] (Array of 1-3 Cloudinary proof URLs: photos <=300KB or video <=15s/15MB)']
  status waste_log_status [not null, default: 'pending_approval']

  Note: 'Two-step waste write-off tracking for internal fraud prevention'

  Indexes {
    batch_id [name: "waste_logs_batch_id_idx"]
    status [name: "waste_logs_status_idx"]
  }
}

// ==========================================
// 4. ORDERS & FEFO BATCH ALLOCATIONS
// ==========================================

Table orders {
  id uuid [pk, note: 'UUIDv7 primary key']
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  order_code varchar(50) [not null, unique, note: 'E.g. ORD-20261112-001']
  customer_id uuid [not null, note: 'Customer placing the order']
  subscription_id uuid [note: 'Nullable FK: links child order generated automatically from recurring subscription']
  shipping_address text [not null]
  shipping_distance_km decimal(6,2) [not null, default: 0, note: 'Calculated via Haversine formula from Farm coordinates']
  shipping_fee integer [not null, default: 0, note: 'Dynamic shipping fee based on distance']
  subtotal integer [not null, note: 'Sum of item prices']
  discount_amount integer [not null, default: 0, note: 'Reward points or voucher deduction']
  total_amount integer [not null, note: 'Final payable amount. For subscription orders, represents delivery installment value (prepaid_amount / total_deliveries)']
  payment_method payment_method [not null, default: 'cod']
  payment_status payment_status [not null, default: 'pending']
  order_status order_status [not null, default: 'pending_confirmation']

  Note: 'Customer purchase orders with complete delivery and financial totals'

  Indexes {
    order_code [unique, name: "orders_order_code_uidx"]
    customer_id [name: "orders_customer_id_idx"]
    subscription_id [name: "orders_subscription_id_idx"]
    (order_status, created_at) [name: "orders_status_created_at_idx"]
  }
}

Table order_items {
  id uuid [pk, note: 'UUIDv7 primary key']
  order_id uuid [not null, note: 'Belongs to order']
  product_id uuid [not null, note: 'Ordered product']
  quantity decimal(10,2) [not null, note: 'Quantity purchased in product units']
  unit_price integer [not null, note: 'Unit price captured at time of purchase']

  Note: 'Individual product line items within a customer order'

  Indexes {
    order_id [name: "order_items_order_id_idx"]
    product_id [name: "order_items_product_id_idx"]
  }
}

Table batch_allocations {
  id uuid [pk, note: 'UUIDv7 primary key']
  order_item_id uuid [not null, note: 'Links to specific order line item']
  batch_id uuid [not null, note: 'Specific batch allocated via FEFO']
  allocated_quantity decimal(10,2) [not null, note: 'Quantity taken from this batch']
  allocated_at timestamp [not null, default: `now()`]

  Note: 'Crucial FEFO allocation bridge: allows one customer item (e.g. 5kg) to be deducted across multiple batches (e.g. 2kg from Batch A + 3kg from Batch B)'

  Indexes {
    order_item_id [name: "batch_allocations_order_item_id_idx"]
    batch_id [name: "batch_allocations_batch_id_idx"]
  }
}

// ==========================================
// 5. RECURRING SUBSCRIPTIONS (PLANS & CONTRACTS)
// ==========================================

Table subscription_plans {
  id uuid [pk, note: 'UUIDv7 primary key']
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  deleted_at timestamp [note: 'Soft delete timestamp (NULL when active); slug unique index scoped WHERE deleted_at IS NULL']
  name varchar(255) [not null, note: 'E.g. Goi Rau Gia Dinh 1 Thang, Goi An Dam Cho Be']
  slug varchar(255) [not null, unique]
  description text [not null]
  price integer [not null, note: 'Prepaid package price in VND (e.g. 1200000)']
  total_deliveries integer [not null, default: 8, note: 'Total scheduled deliveries included (e.g. 8 times for 1 month)']
  weight_per_delivery_kg decimal(5,2) [not null, default: 5.00, note: 'Target produce weight per delivery in kg (e.g. 5.0 kg)']
  basket_description text [not null, note: 'Seasonal harvest guidelines: e.g. 2kg leafy greens + 2kg roots/fruits + 1kg herbs based on current harvest']
  is_active boolean [not null, default: true, note: 'Soft-retire flag: set false to archive plan without breaking running subscriptions']

  Note: 'Predefined recurring subscription package definitions manageable by Admin'

  Indexes {
    slug [unique, name: "subscription_plans_slug_uidx", note: 'Partial unique index: WHERE deleted_at IS NULL']
    is_active [name: "subscription_plans_is_active_idx"]
  }
}

Table subscriptions {
  id uuid [pk, note: 'UUIDv7 primary key']
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  customer_id uuid [not null, note: 'Subscriber']
  plan_id uuid [note: 'Foreign key to original plan definition. Set null if plan is archived']
  user_address_id uuid [note: 'Links to customer address book. Nullable in case address is deleted']
  shipping_address text [not null, note: 'Immutable snapshot of delivery address for 04:00 AM Cron order generation']
  shipping_distance_km decimal(6,2) [not null, default: 0, note: 'Immutable snapshot of distance from farm']
  shipping_fee_per_delivery integer [not null, default: 0, note: 'Immutable shipping fee component per delivery']
  plan_name varchar(255) [not null, note: 'Immutable snapshot of plan name at time of payment']
  price integer [not null, note: 'Immutable snapshot of prepaid price paid by customer']
  total_deliveries integer [not null, note: 'Immutable snapshot of total deliveries contracted']
  weight_per_delivery_kg decimal(5,2) [not null, note: 'Immutable snapshot of target weight per delivery in kg']
  basket_description text [not null, note: 'Immutable snapshot of seasonal harvest basket guidelines']
  delivery_day delivery_day [not null, default: 'tuesday', note: 'Scheduled delivery day: Tuesday, Friday, or Both']
  remaining_deliveries integer [not null, note: 'Remaining deliveries counter, decremented upon child order generation']
  status subscription_status [not null, default: 'active']
  start_date date [not null]
  end_date date [not null]

  Note: 'Active customer subscription contracts featuring dual Foreign Key, Immutable Snapshot pattern, and complete delivery address'

  Indexes {
    customer_id [name: "subscriptions_customer_id_idx"]
    plan_id [name: "subscriptions_plan_id_idx"]
    status [name: "subscriptions_status_idx"]
  }
}
Table payments {
  id uuid [pk, note: 'UUIDv7 primary key']
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  order_id uuid [note: 'Nullable FK: links payment to retail purchase order']
  subscription_id uuid [note: 'Nullable FK: links prepaid payment to recurring subscription package']
  amount integer [not null, note: 'Actual monetary amount in VND']
  payment_method payment_method [not null, default: 'cod']
  status payment_status [not null, default: 'pending']
  transaction_type payment_transaction_type [not null, default: 'payment', note: 'payment (charge) or refund (reimbursement)']
  order_code bigint [unique, note: 'PayOS integer orderCode for VietQR generation and webhook lookup']
  reference_code text [unique, note: 'PayOS/Banking transaction reference code upon success']
  payment_url text [note: 'PayOS checkoutUrl for customer redirection or retry']
  raw_payload jsonb [note: 'JSON Schema: object (PayOS Webhook: { orderCode: number, amount: number, description: string, reference: string, transactionDateTime: string, paymentLinkId: string })']
  verified_by uuid [note: 'Staff/Shipper confirming cash COD payment']
  paid_at timestamp [note: 'Timestamp when gateway confirmed successful capture']

  Note: 'Unified payment ledger supporting retail orders, prepaid subscriptions, PayOS webhooks, and refund audits'

  Indexes {
    order_id [name: "payments_order_id_idx"]
    subscription_id [name: "payments_subscription_id_idx"]
    order_code [unique, name: "payments_order_code_uidx"]
    status [name: "payments_status_idx"]
  }
}


Table complaints {
  id uuid [pk, note: 'UUIDv7 primary key']
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  order_id uuid [not null, unique, note: 'Order being contested (1 complaint per order)']
  customer_id uuid [not null, note: 'Customer filing complaint']
  resolved_by uuid [note: 'Admin resolving the complaint']
  reason text [not null, note: 'Description of spoiled/damaged produce']
  proof_image_urls jsonb [not null, note: 'JSON Schema: string[] (Array of 1 to 5 photo proof URLs within 24h, <=1MB each)']
  proof_video_url varchar(500) [note: 'Nullable: Optional single video URL (Client guardrail: max 15s, <=15MB)']
  status complaint_status [not null, default: 'pending']
  resolution complaint_resolution [note: 'Resolution applied: Refund or Replacement dispatch']

  Note: 'Customer post-delivery quality complaints and refund governance'

  Indexes {
    order_id [unique, name: "complaints_order_id_uidx"]
    customer_id [name: "complaints_customer_id_idx"]
    status [name: "complaints_status_idx"]
  }
}

// ==========================================
// FOREIGN KEY RELATIONSHIPS (REFERENTIAL INTEGRITY)
// ==========================================

// Trong quy chuẩn của dbdiagram (DBML):
// - Toán tử >: Many-to-One (cả 2 bên đều bắt buộc → FK phải NOT NULL).
// - Toán tử ?>: Dấu ? nằm ở bên phải của quan hệ ngữ nghĩa: Nó chỉ cho phép bảng cha (Parent) có 0 con, nhưng BẢNG CON (FK) VẪN BẮT BUỘC PHẢI NOT NULL!
// - Toán tử ?>?: CẢ HAI BÊN ĐỀU TÙY CHỌN! Nghĩa là: Bảng con có thể có FK mang giá trị NULL (chưa duyệt, chưa có gói...), và bảng cha có thể có 0 bản ghi con!

Ref: plots.farm_id > farms.id [delete: cascade]

Ref: seasons.plot_id > plots.id [delete: restrict]

Ref: farming_logs.season_id > seasons.id [delete: cascade]
Ref: refresh_tokens.user_id > users.id [delete: cascade]
Ref: user_addresses.user_id > users.id [delete: cascade]

Ref: categories.parent_id ?>? categories.id [delete: set null]
Ref: farming_logs.staff_id > users.id [delete: restrict]

Ref: products.category_id > categories.id [delete: restrict]

Ref: batches.season_id > seasons.id [delete: restrict]
Ref: batches.product_id > products.id [delete: restrict]

Ref: waste_logs.batch_id > batches.id [delete: restrict]
Ref: waste_logs.reported_by > users.id [delete: restrict]
Ref: waste_logs.approved_by ?>? users.id [delete: set null]

Ref: orders.customer_id > users.id [delete: restrict]
Ref: orders.subscription_id ?>? subscriptions.id [delete: set null]

Ref: order_items.order_id > orders.id [delete: cascade]
Ref: order_items.product_id > products.id [delete: restrict]

Ref: batch_allocations.order_item_id > order_items.id [delete: cascade]
Ref: batch_allocations.batch_id > batches.id [delete: restrict]

Ref: subscriptions.customer_id > users.id [delete: restrict]
Ref: subscriptions.plan_id ?>? subscription_plans.id [delete: set null]
